                                                    # =====================================================================
# Edu-Nexus BE — Production environment template
# =====================================================================
# Copy file này thành `.env` trên server (/opt/edu-nexus/.env) và điền giá trị thật.
# KHÔNG commit file `.env` lên git.
#
#   cp .env.example .env && nano .env
# =====================================================================

# ---------- Image ----------
# Tag image trên GHCR. CI/CD sẽ override bằng commit SHA khi deploy.
API_IMAGE=ghcr.io/edu-nexus-exe/be:latest

# Domain trỏ về VPS để Caddy cấp SSL
API_DOMAIN=api.yourdomain.com

# Domain public dùng để dựng link portfolio chia sẻ (FR6.2).
# Đặt đúng domain người dùng truy cập (vd domain FE). Sai -> link portfolio sai.
APP_PUBLIC_BASE_URL=https://edu-nexus-web.vercel.app

# ---------- Database ----------
POSTGRES_DB=
POSTGRES_USER=postgres
# !!! ĐỔI password mạnh trước khi deploy. KHÔNG dùng default này trên prod.
POSTGRES_PASSWORD=CHANGE_ME_strong_random_pw

# ---------- JWT ----------
# Sinh key dài ngẫu nhiên: `openssl rand -base64 64`
JWT_KEY=CHANGE_ME_long_random_secret_at_least_64_chars
JWT_ISSUER=
JWT_AUDIENCE=
JWT_ACCESS_MIN=15
JWT_REFRESH_DAYS=30

# ---------- Google OAuth ----------
GOOGLE_CLIENT_ID=

# ---------- AI / OpenAI ----------
# Bật true để dùng Real AI (JD/CV parse, assessment, gap, roadmap). Cần OpenAI key.
# Lưu ý: Roadmap/Resource/Assessment KHÔNG có fallback fake — thiếu key sẽ fail.
AI_ENABLED=true
OPENAI_API_KEY=sk-...

# ---------- Swagger ----------
# true = mở Swagger UI ở "/" trên production (không cần sửa code/đổi ASPNETCORE_ENVIRONMENT).
# false = tắt (mặc định, an toàn cho prod).
SWAGGER_ENABLED=false

# ---------- SePay (thanh toán) — BẮT BUỘC nếu bật tính năng nâng cấp gói ----------
# ApiKey: dùng để xác thực webhook SePay (gửi ở header Authorization). Giữ bí mật.
SEPAY_API_KEY=Bearer CHANGE_ME_sepay_webhook_api_key
SEPAY_BANK_ACCOUNT=0399212721
SEPAY_BANK_CODE=OCB
SEPAY_ACCOUNT_NAME=PHAM BAO PHI
# Thời hạn (phút) order pending trước khi tự huỷ. Mặc định 30.
SEPAY_ORDER_TTL_MIN=30

# ---------- Seed admin (tạo tài khoản admin lần đầu khi BE khởi động) ----------
# Bỏ TRỐNG SEED_ADMIN_EMAIL nếu không muốn seed admin (vd sau khi đã có admin).
# DataSeeder idempotent: đã tồn tại email này thì bỏ qua.
SEED_ADMIN_EMAIL=admin@edunexus.vn
SEED_ADMIN_PASSWORD=CHANGE_ME_strong_admin_pw
SEED_ADMIN_FULLNAME=Edu-Nexus Admin
